#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DATASETS=("mnist" "fashionmnist" "cifar10")
MODELS=("cnn" "mlp")
OPTIMIZERS=("sgd" "adam")
mkdir -p "$PROJECT_ROOT/runs/logs"

echo "Submitting jobs for datasets: ${DATASETS[@]} with models: ${MODELS[@]} and optimizers: ${OPTIMIZERS[@]}"

for model in "${MODELS[@]}"; do
    for dataset in "${DATASETS[@]}"; do
        for optimizer in "${OPTIMIZERS[@]}"; do
            echo "Submitting: model=$model dataset=$dataset optimizer=$optimizer"
            sbatch --job-name="monofwd_${model}_${dataset}_${optimizer}" \
                   --output="$PROJECT_ROOT/runs/logs/train_${model}_${dataset}_${optimizer}_%j.out" \
                   "$PROJECT_ROOT/scripts/train.slurm" --dataset "$dataset" --model "$model" \
                   --optimizer "$optimizer" \
                   --no-early-stopping
        done
    done
done

echo "All jobs submitted!"
