#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DATASETS=("mnist" "fashionmnist" "cifar10" "cifar100")
MODELS=("cnn" "mlp")

mkdir -p "$PROJECT_ROOT/runs/logs"

echo "Submitting jobs for datasets: ${DATASETS[@]} with models: ${MODELS[@]}"

for model in "${MODELS[@]}"; do
    for dataset in "${DATASETS[@]}"; do
        echo "Submitting: model=$model dataset=$dataset"
        sbatch --job-name="monofwd_${model}_${dataset}" \
               --output="$PROJECT_ROOT/runs/logs/train_${model}_${dataset}_%j.out" \
               "$PROJECT_ROOT/scripts/train.slurm" \
               --dataset "$dataset" \
               --model "$model" \
               --epochs 200 \
               --no-early-stopping
    done
done

echo "All jobs submitted!"
