#!/bin/bash
#   bash scripts/gridsearch.sh [mlp|cnn|all] [dataset]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

MODEL=${1:-all}
DATASET=${2:-cifar10}

OPTIMIZERS=("adam" "sgd")
LRS=(0.2 0.1 0.02 0.01 0.005 0.001)
BATCH_SIZES=(64 128 256)

MLP_STEP_SIZES=(15 20 30)
MLP_EPOCHS=200
CNN_EPOCHS=300

LOG_DIR="$PROJECT_ROOT/runs/logs/gridsearch"
mkdir -p "$LOG_DIR"

submit_mlp() {
    local total=0
    for opt in "${OPTIMIZERS[@]}"; do
        for lr in "${LRS[@]}"; do
            for step in "${MLP_STEP_SIZES[@]}"; do
                for bs in "${BATCH_SIZES[@]}"; do
                    job_name="gs_mlp_${opt}_lr${lr}_step${step}_bs${bs}"
                    sbatch \
                        --job-name="$job_name" \
                        --output="$LOG_DIR/${job_name}_%j.out" \
                        "$PROJECT_ROOT/scripts/train.slurm" \
                        --model mlp \
                        --dataset "$DATASET" \
                        --optimizer "$opt" \
                        --lr "$lr" \
                        --scheduler_step_size "$step" \
                        --batch_size "$bs" \
                        --epochs "$MLP_EPOCHS"
                    ((total++))
                done; 
            done; 
        done; 
    done
    echo "Submitted $total MLP jobs (dataset=$DATASET)"
}

submit_cnn() {
    local total=0
    for opt in "${OPTIMIZERS[@]}"; do
        for lr in "${LRS[@]}"; do
            for bs in "${BATCH_SIZES[@]}"; do
                job_name="gs_cnn_${opt}_lr${lr}_bs${bs}"
                sbatch \
                    --job-name="$job_name" \
                    --output="$LOG_DIR/${job_name}_%j.out" \
                    "$PROJECT_ROOT/scripts/train.slurm" \
                    --model cnn \
                    --dataset "$DATASET" \
                    --optimizer "$opt" \
                    --lr "$lr" \
                    --batch_size "$bs" \
                    --epochs "$CNN_EPOCHS"
                ((total++))
            done; 
        done; 
    done
    echo "Submitted $total CNN jobs (dataset=$DATASET)"
}

case "$MODEL" in
    mlp) submit_mlp ;;
    cnn) submit_cnn ;;
    all) submit_mlp; submit_cnn ;;
    *) echo "Unknown model '$MODEL'. Use: mlp, cnn, or all"; exit 1 ;;
esac
